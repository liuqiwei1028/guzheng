<view class="page">
  <view class="hero">
    <view class="eyebrow">GUZHENG TIMBRE AI</view>
    <view class="title">古筝 AI 音色鉴赏</view>
    <view class="desc">请先使用微信或手机号登录，登录后即可进入音色分析、声档对比和 AI 报告。</view>
  </view>

  <view class="panel">
    <button class="primary-btn" loading="{{loadingWechat}}" disabled="{{loadingWechat || loadingPhone}}" bindtap="loginWithWechat">
      微信登录
    </button>
    <button
      class="phone-btn"
      open-type="getPhoneNumber"
      bindgetphonenumber="loginWithPhone"
      loading="{{loadingPhone}}"
      disabled="{{loadingWechat || loadingPhone}}"
    >
      手机号登录
    </button>
    <view class="tip">手机号登录需小程序主体已认证并开通手机号快速验证能力。</view>
  </view>

  <view wx:if="{{message}}" class="message">{{message}}</view>
</view>
